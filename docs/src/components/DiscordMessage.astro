---
/**
 * A mock of a Discord message, so a code sample can sit next to what it
 * produces. The colours are Discord's own on purpose: this depicts Discord,
 * it is not part of the site's palette. Put embeds and buttons in the slot.
 */
interface Props {
  author?: string;
  /** Shows the APP tag next to the name. */
  bot?: boolean;
  time?: string;
  /** Avatar background. */
  color?: string;
  /** Message text shown above any embed. May contain inline HTML. */
  content?: string;
  /** Renders the "X used /command" line Discord shows above a command reply. */
  used?: { user: string; command: string };
  /** A small label above the frame, for example "Result in Discord". */
  caption?: string;
}
const { author = "djs-bot", bot = true, time = "Today at 14:02", color = "#5865f2", content, used, caption } = Astro.props;
// The first grapheme, so that an emoji-first name does not yield half a character.
const first = [...new Intl.Segmenter(undefined, { granularity: "grapheme" }).segment(author.trim())][0]?.segment ?? "?";
---

<figure class="dc not-content" aria-label={`Discord message from ${author}`}>
  {caption && <figcaption class="dc-cap">{caption}</figcaption>}
  <div class="dc-msg">
    <div class="dc-av" style={`background:${color}`} aria-hidden="true">{first.toUpperCase()}</div>
    <div class="dc-main">
      {used && <div class="dc-used">{used.user} used <b>/{used.command}</b></div>}
      <div class="dc-meta">
        <b>{author}</b>
        {bot && <span class="dc-app">APP</span>}
        <time>{time}</time>
      </div>
      {content && <p set:html={content} />}
      <slot />
    </div>
  </div>
</figure>

<style is:global>
  .dc { --dc-bg: #313338; --dc-fg: #dbdee1; --dc-name: #f2f3f5; --dc-muted: #949ba4; margin: 1.25rem 0 0; color: var(--dc-fg); font-family: "gg sans", "Noto Sans", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 0.9375rem; line-height: 1.375; }
  .dc-cap { margin-bottom: 0.6rem; font-family: var(--sl-font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--at-faint); }
  .dc-msg { display: flex; gap: 0.875rem; padding: 0.875rem 1rem; border: 1px solid var(--at-line); border-radius: var(--at-radius); background: var(--dc-bg); }
  .dc-av { flex-shrink: 0; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; color: #fff; font-weight: 700; user-select: none; }
  .dc-main { min-width: 0; flex: 1; }
  .dc-main > p { margin: 0; color: var(--dc-fg); overflow-wrap: anywhere; }
  .dc-meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem; }
  .dc-meta b { color: var(--dc-name); font-weight: 600; overflow-wrap: anywhere; }
  .dc-app { align-self: center; padding: 0.05rem 0.3rem; border-radius: 4px; background: #5865f2; color: #fff; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.02em; }
  .dc-meta time { color: var(--dc-muted); font-size: 0.75rem; }
  .dc-used { margin-bottom: 0.25rem; color: var(--dc-muted); font-size: 0.8125rem; overflow-wrap: anywhere; }
  .dc-used b { color: #c9cdfb; font-weight: 500; }
</style>
