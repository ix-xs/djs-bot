---
// The site header: brand, the three top-level areas, search, language,
// repository, theme.
// On small screens only the brand and the search remain; the rest lives in the
// navigation sheet, which Starlight opens from its own menu button.
import Search from "virtual:starlight/components/Search";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import SearchExtras from "./SearchExtras.astro";
import { LOCALES, normalizeBase, switchLocale, withBase } from "../../plugins/base-links.mjs";
import { href, useT } from "../i18n";
import pkg from "../../../package.json";

const { locale } = Astro.locals.starlightRoute;
const t = useT(locale);
const base = normalizeBase(import.meta.env.BASE_URL);
// Where this page is, whatever its language.
const path = switchLocale(Astro.url.pathname.slice(base.length) || "/", undefined);
const inReference = path.startsWith("/reference/") || path.startsWith("/api/");

const areas = [
  { label: t("nav.docs"), href: "/", current: !inReference },
  { label: t("nav.reference"), href: "/reference/", current: inReference },
];
// The host serves one "not found" page, the English one, whatever the address
// asked for. Under a translation, it hands over to that language's own.
const notFound = /^\/404(?:\.html|\/)?$/.test(Astro.url.pathname.slice(base.length) || "/");
const translatedNotFound = LOCALES.map((code) => [withBase(`/${code}/`, base), withBase(`/${code}/404/`, base)]);
// The published minor version, read from the package itself.
const version = pkg.version.split(".").slice(0, 2).join(".");
---

{notFound && (
  <script is:inline define:vars={{ translatedNotFound }}>
    for (const [prefix, page] of translatedNotFound) {
      if (location.pathname.startsWith(prefix) && location.pathname !== page) location.replace(page);
    }
  </script>
)}

<div class="at-header">
  <a class="at-brand" href={Astro.locals.starlightRoute.siteTitleHref} translate="no">
    <span>djs<i>-</i>bot</span><small>v{version}</small>
  </a>
  <nav class="at-toplinks" aria-label={t("nav.sections")}>
    {areas.map((area) => (
      <a href={href(area.href, locale)} aria-current={area.current ? "true" : undefined}>{area.label}</a>
    ))}
  </nav>
  <span class="at-spacer"></span>
  <Search />
  <div class="at-actions">
    <LanguageSelect />
    <a class="at-icon-btn at-press" href="https://github.com/ix-xs/djs-bot" aria-label={t("nav.github")}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.55v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.4-5.27 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.66.8.55A11.5 11.5 0 0 0 12 .5Z"/></svg>
    </a>
    <ThemeSelect />
  </div>
</div>
<SearchExtras />

<script>
  // The sidebar's scrollbar: a thin thumb over the list, shown while it
  // scrolls or under the pointer, gone shortly after. Touch screens keep their
  // own, which already behaves so.
  const pane = document.querySelector<HTMLElement>(".sidebar-pane");
  if (pane && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    pane.classList.add("at-scroll");
    const thumb = document.createElement("div");
    thumb.className = "at-scroll-thumb";
    thumb.setAttribute("aria-hidden", "true");
    document.body.append(thumb);
    let hideTimer = 0;
    let hovered = false;
    const draw = () => {
      const box = pane.getBoundingClientRect();
      const visible = pane.clientHeight;
      const total = pane.scrollHeight;
      if (total <= visible + 1 || box.width === 0) {
        thumb.removeAttribute("data-on");
        thumb.style.display = "none";
        return false;
      }
      thumb.style.display = "";
      const size = Math.max(32, (visible / total) * visible);
      const top = box.top + (pane.scrollTop / (total - visible)) * (visible - size);
      thumb.style.height = `${size}px`;
      thumb.style.transform = `translate(${box.right - 7}px, ${top}px)`;
      return true;
    };
    const reveal = () => {
      if (!draw()) return;
      thumb.setAttribute("data-on", "");
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        if (!hovered) thumb.removeAttribute("data-on");
      }, 700);
    };
    pane.addEventListener("scroll", reveal, { passive: true });
    pane.addEventListener("pointerenter", () => ((hovered = true), reveal()));
    pane.addEventListener("pointerleave", () => {
      hovered = false;
      reveal();
    });
    addEventListener("resize", () => draw());
    draw();
  }

  // "On this page": a marker that slides along the hairline to the heading
  // being read. Starlight marks that heading's link (aria-current); the marker
  // follows it, without moving on its first placement.
  const tocList = document.querySelector<HTMLElement>(".right-sidebar starlight-toc nav > ul");
  if (tocList) {
    const marker = document.createElement("span");
    marker.className = "at-toc-marker";
    marker.setAttribute("aria-hidden", "true");
    tocList.prepend(marker);
    const links = [...tocList.querySelectorAll<HTMLElement>("a")];
    const targets = links
      .map((link) => [link, document.getElementById(decodeURIComponent(link.getAttribute("href")?.slice(1) ?? ""))] as const)
      .filter((pair): pair is readonly [HTMLElement, HTMLElement] => pair[1] !== null && pair[1].id !== "_top");
    const follow = () => {
      // Before the first scroll, nothing is marked yet: the top of the page is
      // being read. At the very bottom, the last section is, even when it is
      // too short to reach the top of the window, where Starlight looks.
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4 && scrollY > 0;
      let current = links[0];
      if (atBottom) current = links[links.length - 1];
      else {
        // The last heading that has passed a third of the way down the window.
        for (const [link, heading] of targets) {
          if (heading.getBoundingClientRect().top <= innerHeight / 3) current = link;
          else break;
        }
      }
      for (const link of links) link.toggleAttribute("data-at-current", link === current);
      marker.style.opacity = current ? "1" : "0";
      if (!current) return;
      const top = current.getBoundingClientRect().top - tocList.getBoundingClientRect().top;
      marker.style.transform = `translateY(${top}px) scaleY(${current.offsetHeight})`;
      if (!marker.hasAttribute("data-ready")) requestAnimationFrame(() => marker.setAttribute("data-ready", ""));
    };
    follow();
    new MutationObserver(follow).observe(tocList, { subtree: true, attributes: true, attributeFilter: ["aria-current"] });
    addEventListener("resize", follow);
    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          follow();
        });
      },
      { passive: true },
    );
  }

  // A sliding marker under the selected tab. It slides for a pointer, and jumps
  // for the keyboard: arrowing through tabs should never wait on an animation.
  let lastPointer = 0;
  function place(list: HTMLElement, animate: boolean): void {
    const active = list.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]');
    if (!active || active.offsetWidth === 0) return;
    let marker = list.querySelector<HTMLElement>(".at-tab-indicator");
    if (!marker) {
      marker = document.createElement("li");
      marker.className = "at-tab-indicator";
      marker.setAttribute("role", "presentation");
      list.append(marker);
      list.closest("starlight-tabs")?.setAttribute("data-at-indicator", "");
    }
    if (!animate) list.removeAttribute("data-at-ready");
    marker.style.transform = `translateX(${active.offsetLeft}px) scaleX(${active.offsetWidth / 100})`;
    if (!animate) requestAnimationFrame(() => requestAnimationFrame(() => list.setAttribute("data-at-ready", "")));
  }
  const lists = [...document.querySelectorAll<HTMLElement>('starlight-tabs [role="tablist"]')];
  for (const list of lists) {
    place(list, false);
    list.addEventListener("pointerdown", () => (lastPointer = performance.now()));
    new MutationObserver(() => place(list, performance.now() - lastPointer < 600)).observe(list, {
      subtree: true,
      attributes: true,
      attributeFilter: ["aria-selected"],
    });
  }
  if (lists.length > 0) addEventListener("resize", () => lists.forEach((list) => place(list, false)));
</script>
