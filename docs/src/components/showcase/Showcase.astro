---
// The landing page's showcase: pick a kind of feature, read the file that
// implements it, and play what it does in Discord. Each thing the framework
// does lights up the lines of the file that asked for it.
//
// The Discord on the right has a language of its own, the one of its user
// (the page's, to begin with). The bot answers in it: its names come from
// `nameLocalizations`, its messages from `ctx.t`. Everything it says is
// rendered in both languages (`data-l`), and the showcase shows one.
//
// A scene is a small script. Elements carry the steps during which they are
// there (`data-at`, `data-until`), and what moves the scene on:
//   data-go="n"       pressing it brings the scene to step n (from n - 1 only);
//                     several steps ("1 2") for a control that is pressed again
//   data-field="x"    a field the reader fills in, copied into [data-echo="x"]
//   data-auto="ms"    once shown (and typed), the scene moves on by itself
//   data-typed-en/fr  the text is typed out when the element appears
//   data-pick-en/fr   with data-go: the text copied into every [data-echo]
//   data-disable-at   a button that stays, disabled, from that step
import { Code } from "@astrojs/starlight/components";
import { DISCORD, SCENES, WORDS, say, type Lang } from "../../showcase/scenes";
import Msg from "./Msg.astro";
import "../../styles/showcase.css";

const page: Lang = Astro.locals.starlightRoute.locale === "fr" ? "fr" : "en";
const LANGS: Lang[] = ["en", "fr"];
const w = (key: keyof typeof WORDS): string => WORDS[key][page];
/** A piece of text in both languages, of which the showcase shows one. */
const both = (text: (lang: Lang) => string): string => LANGS.map((lang) => `<span data-l="${lang}">${text(lang)}</span>`).join("");
/** A word of the Discord app. */
const d = (key: keyof typeof DISCORD): string => both((lang) => DISCORD[key][lang]);
/** A message of the sample bot. */
const s = (key: string, vars: Record<string, string> = {}): string => both((lang) => say(lang, key, vars));
/** The line Discord shows above the reply to a command, with the command's name in each language. */
const used = (en: string, fr: string): string => both((lang) => `Jo ${DISCORD.used[lang]} <b>/${lang === "fr" ? fr : en}</b>`);
const mention = (name: string): string => `<span class="sc-mention">@${name}</span>`;
/** The last step of a scene: the highest one its trace mentions. */
const last = (id: string): number => Math.max(...SCENES.find((scene) => scene.id === id)!.trace.map((line) => line.at));
const intro = `<b aria-hidden="true">#</b><p><strong>${d("welcome")}</strong>${d("start")}</p>`;
const FRUITS = ["mango", "melon"];
const COLOURS = [
  { id: "red", emoji: "🔴" },
  { id: "blue", emoji: "🔵" },
];
---

<at-showcase class="sc not-content" data-client={page}>
  <div class="sc-railwrap">
    <button type="button" class="sc-rail-go" data-rail="-1" tabindex="-1" aria-label={w("earlier")}><span aria-hidden="true">‹</span></button>
    <div class="sc-rail" role="tablist" aria-label={w("kinds")}>
    {SCENES.map((scene, index) => (
      <button
        type="button"
        role="tab"
        id={`sc-tab-${scene.id}`}
        aria-controls={`sc-scene-${scene.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-tab={scene.id}
      >
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>{scene.label[page]}
      </button>
    ))}
    <i class="sc-mark" aria-hidden="true"></i>
    </div>
    <button type="button" class="sc-rail-go" data-rail="1" tabindex="-1" aria-label={w("later")}><span aria-hidden="true">›</span></button>
  </div>

  <div class="sc-stage">
    {SCENES.map((scene, index) => (
      <section
        class="sc-scene"
        role="tabpanel"
        id={`sc-scene-${scene.id}`}
        aria-labelledby={`sc-tab-${scene.id}`}
        data-scene={scene.id}
        data-active={index === 0 ? "" : undefined}
      >
        <div class="sc-code">
          <Code code={scene.code.trimEnd()} lang="ts" title={scene.file} />
        </div>

        <div class:list={["sc-screen", scene.id === "job" && "is-term"]}>
          <div class="sc-chan">
            {scene.id === "job" ? (
              <p>{w("terminal")}</p>
            ) : (
              <>
                <p><span aria-hidden="true">#</span><Fragment set:html={d("channel")} /></p>
                <div class="sc-client" role="group" aria-label={w("client")}>
                  {LANGS.map((lang) => (
                    <button type="button" data-client-set={lang} aria-pressed={lang === page ? "true" : "false"}>{lang.toUpperCase()}</button>
                  ))}
                </div>
              </>
            )}
          </div>

          {scene.id === "command" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <Msg time={d("today")} used={used("profile", "profil")} at={1}>
                  <p class="sc-dots" data-at="1" data-until="2" data-auto="800" aria-label={DISCORD.typing[page]}><i></i><i></i><i></i></p>
                  <p class="sc-embed is-ok" data-at="2">✅ <Fragment set:html={s("profile.of", { user: mention("Aleksandra") })} /></p>
                </Msg>
              </div>
              <div class="sc-composer">
                <span class="sc-typed" data-until="1" data-typed-en="/profile user:@Aleksandra" data-typed-fr="/profil joueur:@Aleksandra"></span>
                <span class="sc-hint" data-at="1" set:html={d("composer")} />
                <button type="button" class="sc-send" data-until="1" data-go="1" aria-label={DISCORD.send[page]}>↵</button>
              </div>
            </>
          )}

          {scene.id === "autocomplete" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <Msg time={d("today")} used={used("fruit", "fruit")} at={2}>
                  <p class="sc-embed is-ok">✅ <Fragment set:html={both((lang) => say(lang, "fruit.picked", { fruit: "<span data-echo></span>" }))} /></p>
                </Msg>
              </div>
              <div class="sc-pop sc-suggest" data-at="1" data-until="2">
                <p set:html={both((lang) => (lang === "fr" ? "nom" : "name"))} />
                {FRUITS.map((id) => (
                  <button type="button" data-go="2" data-pick-en={say("en", `fruit.${id}`)} data-pick-fr={say("fr", `fruit.${id}`)} set:html={s(`fruit.${id}`)} />
                ))}
              </div>
              <div class="sc-composer">
                <span class="sc-typed" data-until="2" data-typed-en="/fruit name:m" data-typed-fr="/fruit nom:m" data-auto="200"></span>
                <span class="sc-hint" data-at="2" set:html={d("composer")} />
              </div>
            </>
          )}

          {scene.id === "button" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <Msg time={d("today")} used={used("ticket", "ticket")}>
                  <p data-until="2" set:html={s("ticket.opened", { id: "T-1042" })} />
                  <p data-at="2" set:html={s("ticket.closed", { id: "T-1042" })} />
                  <p class="sc-row" data-until="2"><button type="button" class="sc-btn is-danger" data-go="1 2">🔒 <Fragment set:html={s("ticket.close")} /></button></p>
                </Msg>
                <Msg time={d("today")} ephemeral={d("onlyYou")} at={1} until={2}>
                  <p class="sc-embed is-error">❌ <Fragment set:html={s("ticket.notYours")} /></p>
                </Msg>
              </div>
              <p class="sc-actor" data-until="1"><i style="background:#ed4245" aria-hidden="true">M</i><span set:html={w("actor").replace("{who}", `<b>Mallory</b>, ${w("stranger")}`)} /></p>
              <p class="sc-actor" data-at="1" data-until="2"><i style="background:#3ba55c" aria-hidden="true">J</i><span set:html={w("actor").replace("{who}", `<b>Jo</b>, ${w("owner")}`)} /></p>
              <div class="sc-composer"><span class="sc-hint" set:html={d("composer")} /></div>
            </>
          )}

          {scene.id === "select" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <Msg time={d("today")} used={used("colour", "couleur")}>
                  <p data-until="2" set:html={s("colour.which")} />
                  <p data-at="2" set:html={both((lang) => say(lang, "colour.chosen", { colour: "<span data-echo></span>" }))} />
                  <div class="sc-anchor" data-until="2">
                    <button type="button" class="sc-select" data-go="1"><Fragment set:html={s("colour.pick")} /><span aria-hidden="true">⌄</span></button>
                    <div class="sc-pop sc-options" data-at="1" data-until="2">
                      {COLOURS.map(({ id, emoji }) => (
                        <button type="button" data-go="2" data-pick-en={say("en", `colour.${id}`)} data-pick-fr={say("fr", `colour.${id}`)}>
                          {emoji} <Fragment set:html={s(`colour.${id}`)} />
                        </button>
                      ))}
                    </div>
                  </div>
                </Msg>
              </div>
              <div class="sc-composer"><span class="sc-hint" set:html={d("composer")} /></div>
            </>
          )}

          {scene.id === "modal" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <Msg time={d("today")} used={used("report", "signaler")} at={2}>
                  <p class="sc-embed is-ok">✅ <Fragment set:html={both((lang) => say(lang, "report.sent", { kind: '<span data-echo="kind"></span>', details: '<span data-echo="details"></span>' }))} /></p>
                </Msg>
              </div>
              <div class="sc-composer">
                <span class="sc-typed" data-until="1" data-typed-en="/report" data-typed-fr="/signaler"></span>
                <span class="sc-hint" data-at="1" set:html={d("composer")} />
                <button type="button" class="sc-send" data-until="1" data-go="1" aria-label={DISCORD.send[page]}>↵</button>
              </div>
              <div class="sc-scrim" data-at="1" data-until="2"></div>
              <div class="sc-modal" data-at="1" data-until="2" role="group" aria-label={say(page, "report.title")}>
                <p class="sc-modal-title" set:html={s("report.title")} />
                <p class="sc-label"><Fragment set:html={s("report.kind")} /> <b>*</b></p>
                <select class="sc-field" data-field="kind" aria-label={say(page, "report.kind")}>
                  <option value="bug">Bug</option>
                  <option value="spam">Spam</option>
                </select>
                <p class="sc-label"><Fragment set:html={s("report.details")} /> <b>*</b></p>
                <textarea class="sc-field is-area" data-field="details" rows="2" maxlength="120" aria-label={say(page, "report.details")} data-typed-en="The export button does nothing." data-typed-fr="Le bouton d'export ne fait rien."></textarea>
                <label class="sc-check"><input type="checkbox" /> <Fragment set:html={s("report.urgent")} /></label>
                <p class="sc-modal-actions">
                  <button type="button" class="sc-btn is-ghost" data-replay set:html={d("cancel")} />
                  <button type="button" class="sc-btn is-primary" data-go="2" data-submit set:html={d("submit")} />
                </p>
              </div>
            </>
          )}

          {scene.id === "context" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <Msg author="Mallory" bot={false} color="#ed4245" time={d("today")}>
                  <p set:html={both((lang) => (lang === "fr" ? "NITRO GRATUIT sur totally-legit.example" : "FREE NITRO at totally-legit.example"))} />
                  <div class="sc-anchor is-tools" slot="tools">
                    <button type="button" class="sc-more" data-go="1" aria-label={DISCORD.more[page]}>⋯</button>
                    <div class="sc-pop sc-menu" data-at="1" data-until="2">
                      <p set:html={d("reply")} />
                      <p set:html={d("copy")} />
                      <hr />
                      <p class="sc-menu-head" set:html={d("apps")} />
                      <button type="button" data-go="2"><i aria-hidden="true">D</i><Fragment set:html={both((lang) => (lang === "fr" ? "Signaler le message" : "Report message"))} /></button>
                    </div>
                  </div>
                </Msg>
                <Msg time={d("today")} ephemeral={d("onlyYou")} at={2}>
                  <p class="sc-embed is-ok">✅ <Fragment set:html={s("report.done")} /></p>
                </Msg>
              </div>
              <div class="sc-composer"><span class="sc-hint" set:html={d("composer")} /></div>
            </>
          )}

          {scene.id === "event" && (
            <>
              <div class="sc-feed">
                <div class="sc-intro" set:html={intro} />
                <p class="sc-center" data-until="1"><button type="button" class="sc-chip" data-go="1">{w("join")}</button></p>
                <p class="sc-system" data-at="1"><span aria-hidden="true">→</span><span><b>Jo</b> <Fragment set:html={d("joined")} /></span></p>
                <Msg time={d("today")} at={1}>
                  <p class="sc-dots" data-at="1" data-until="2" data-auto="700" aria-label={DISCORD.typing[page]}><i></i><i></i><i></i></p>
                  <p data-at="2" set:html={s("welcome", { member: mention("Jo") })} />
                </Msg>
              </div>
              <div class="sc-composer"><span class="sc-hint" set:html={d("composer")} /></div>
            </>
          )}

          {scene.id === "job" && (
            <div class="sc-feed">
              <p class="sc-log"><span>$</span> npx djs-bot start</p>
              <p class="sc-center" data-until="1"><button type="button" class="sc-chip" data-go="1">{w("midnight")}</button></p>
              <p class="sc-log" data-at="1"><span>00:00:00</span> <b>INFO</b>  daily stats saved <span>{'{"guilds":42}'}</span></p>
            </div>
          )}
        </div>

        <div class="sc-trace">
          <ol class="sc-steps" aria-label={w("happened")}>
            {scene.trace.map((_, line) => (
              <li><button type="button" data-line={line} disabled aria-label={w("step").replace("{n}", String(line + 1))}>{line + 1}</button></li>
            ))}
          </ol>
          <div class="sc-caption" aria-live="polite">
            <p class="sc-idle" data-until="1">{w("idle")}</p>
            {scene.trace.map((line, index) => (
              <p data-caption={index} data-from={line.at} data-lines={line.lines.join("-")} set:html={line.text[page]} />
            ))}
          </div>
          <p class="sc-after" data-at={last(scene.id)}>
            <button type="button" class="sc-replay" data-replay>{w("replay")}</button>
            <button type="button" class="sc-next at-press" data-next>{w("next")}<span aria-hidden="true">→</span></button>
          </p>
        </div>
      </section>
    ))}
  </div>
</at-showcase>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const num = (value: string | undefined, fallback: number): number => (value === undefined || value === "" ? fallback : Number(value));
  /** How long a line of the trace stays before the next one takes its place. */
  const READ = 1500;

  /** One scene: its panel, the step it is at, and the timers it has running. */
  class Scene {
    step = 0;
    private demo = false;
    private timers = new Set<number>();
    private reading = new Set<number>();
    private shown = 0;
    private readonly parts: HTMLElement[];
    private readonly lines: HTMLElement[];
    private readonly captions: HTMLElement[];
    private readonly dots: HTMLButtonElement[];
    private readonly fields: (HTMLSelectElement | HTMLTextAreaElement)[];

    constructor(readonly root: HTMLElement) {
      this.fields = [...root.querySelectorAll<HTMLSelectElement | HTMLTextAreaElement>("[data-field]")];
      // Once the reader writes in a field, it is theirs: the typing stops.
      for (const input of this.fields) {
        const take = (event: Event) => {
          if (!event.isTrusted) return;
          input.dataset.touched = "";
          input.removeAttribute("data-invalid");
        };
        input.addEventListener("input", take);
        input.addEventListener("pointerdown", take);
      }
      this.parts = [...root.querySelectorAll<HTMLElement>("[data-at], [data-until]")];
      this.lines = [...root.querySelectorAll<HTMLElement>(".sc-code .ec-line")];
      this.captions = [...root.querySelectorAll<HTMLElement>("[data-caption]")];
      this.dots = [...root.querySelectorAll<HTMLButtonElement>("[data-line]")];
      root.addEventListener("click", (event) => this.press(event));
    }

    /** The language of the Discord on screen: "en" or "fr". */
    private get client(): string {
      return this.root.closest<HTMLElement>("at-showcase")?.dataset.client ?? "en";
    }
    /** The value of a `data-<name>-en` / `data-<name>-fr` pair for that language. */
    private local(element: HTMLElement, name: string): string | undefined {
      return element.dataset[name + (this.client === "fr" ? "Fr" : "En")];
    }

    private later(run: () => void, ms: number, list = this.timers): void {
      const id = window.setTimeout(() => {
        list.delete(id);
        run();
      }, ms);
      list.add(id);
    }
    private stop(list: Set<number>): void {
      for (const id of list) window.clearTimeout(id);
      list.clear();
    }

    /** Whether every field of the form is filled in. The first empty one is pointed at. */
    private complete(): boolean {
      const empty = this.fields.find((input) => input.value.trim() === "");
      empty?.setAttribute("data-invalid", "");
      empty?.focus();
      return !empty;
    }

    /** Stops everything and goes back to the first step, without playing it. */
    rest(): void {
      this.stop(this.timers);
      this.stop(this.reading);
      this.step = 0;
      this.demo = false;
      this.shown = 0;
      for (const typed of this.root.querySelectorAll<HTMLElement>("[data-typed-en]")) this.write(typed, "");
      for (const input of this.fields) {
        delete input.dataset.touched;
        input.removeAttribute("data-invalid");
        if (input instanceof HTMLSelectElement) input.selectedIndex = 0;
      }
      for (const box of this.root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) box.checked = false;
      for (const line of this.lines) line.classList.remove("sc-hot", "sc-warm");
      for (const caption of this.captions) caption.removeAttribute("data-current");
      for (const dot of this.dots) {
        dot.disabled = true;
        dot.removeAttribute("aria-current");
      }
      this.draw(false);
    }

    /** Plays the scene from its first step. With `demo`, it also presses what a reader would. */
    play(demo = false): void {
      this.rest();
      this.demo = demo;
      this.draw(true);
    }

    private go(step: number): void {
      this.step = step;
      this.draw(true);
    }

    private press(event: MouseEvent): void {
      const target = event.target as Element | null;
      if (target?.closest("[data-replay]")) {
        this.play();
        this.root.querySelector<HTMLElement>("[data-hint]")?.focus({ preventScroll: true });
        return;
      }
      // A step of the trace that was reached can be read again.
      const dot = target?.closest<HTMLButtonElement>("[data-line]");
      if (dot) {
        this.stop(this.reading);
        this.read(Number(dot.dataset.line));
        return;
      }
      const control = target?.closest<HTMLElement>("[data-go]");
      if (!control || control.closest("[data-off]") || !control.dataset.go!.split(" ").includes(String(this.step + 1))) return;
      // A form is sent only when what it requires is filled in, as in Discord.
      if (control.hasAttribute("data-submit") && !this.complete()) return;
      // A real press takes over from the demonstration.
      if (event.isTrusted) this.demo = false;
      const picked = this.local(control, "pick");
      if (picked) {
        for (const echo of this.root.querySelectorAll('[data-echo=""]')) echo.textContent = picked;
      }
      // What the reader filled in is what the bot answers with.
      for (const input of this.fields) {
        const value = input instanceof HTMLSelectElement ? (input.selectedOptions[0]?.value ?? "") : input.value.trim();
        for (const echo of this.root.querySelectorAll(`[data-echo="${input.dataset.field}"]`)) echo.textContent = value;
      }
      this.go(this.step + 1);
    }

    /** Shows what belongs to the current step. With `live`, what appears is typed, timed and traced. */
    private draw(live: boolean): void {
      const arrived: HTMLElement[] = [];
      for (const part of this.parts) {
        const on = this.step >= num(part.dataset.at, 0) && this.step < num(part.dataset.until, Infinity);
        if (on === !part.hasAttribute("data-off")) continue;
        part.toggleAttribute("data-off", !on);
        if (on) arrived.push(part);
      }
      for (const button of this.root.querySelectorAll<HTMLButtonElement>("[data-disable-at]")) {
        button.disabled = this.step >= Number(button.dataset.disableAt);
      }
      // The control that moves the scene on gets a ring, so the next move is never a guess.
      for (const hinted of this.root.querySelectorAll("[data-hint]")) hinted.removeAttribute("data-hint");
      const next = [...this.root.querySelectorAll<HTMLElement>(`[data-go~="${this.step + 1}"]`)].find((control) => !control.closest("[data-off]"));
      next?.setAttribute("data-hint", "");
      if (!live) return;

      // At the first step nothing "arrives": start what is already there.
      const starting = this.step === 0 ? this.parts.filter((part) => !part.hasAttribute("data-off")) : arrived;
      const typed = new Set(starting.flatMap((part) => (part.dataset.typedEn ? [part] : [...part.querySelectorAll<HTMLElement>("[data-typed-en]")])));
      for (const element of typed) this.type(element);
      for (const part of starting) {
        if (part.dataset.auto && !typed.has(part)) this.later(() => this.go(this.step + 1), Number(part.dataset.auto));
      }
      // In a demonstration, what a reader would press is pressed after a beat
      // (after the typing, when there is some).
      if (this.demo && next && typed.size === 0 && !starting.some((part) => part.dataset.auto)) this.later(() => next.click(), 900);

      // The lines of the trace this step reached are read out one after the
      // other, each long enough to be read; the last one stays.
      const reached = this.captions.filter((caption) => Number(caption.dataset.from) <= this.step).length;
      if (reached > this.shown) {
        this.stop(this.reading);
        const first = this.shown;
        this.shown = reached;
        for (let index = first; index < reached; index++) this.later(() => this.read(index), (index - first) * READ, this.reading);
      }
    }

    /** Puts text in an element, or in a field. */
    private write(element: HTMLElement, text: string): void {
      if (element instanceof HTMLTextAreaElement) element.value = text;
      else element.textContent = text;
    }

    private type(element: HTMLElement): void {
      const text = this.local(element, "typed") ?? "";
      const done = () => {
        if (element.dataset.auto) this.later(() => this.go(this.step + 1), Number(element.dataset.auto));
        else if (this.demo) this.later(() => this.root.querySelector<HTMLElement>("[data-hint]")?.click(), 700);
      };
      if (reduced.matches) {
        this.write(element, text);
        done();
        return;
      }
      let shown = 0;
      const tick = () => {
        // The reader took the field over.
        if ("touched" in element.dataset) return;
        this.write(element, text.slice(0, ++shown));
        if (shown < text.length) this.later(tick, 26 + (shown % 3) * 9);
        else done();
      };
      this.later(tick, 220);
    }

    /** Puts one line of the trace in front, and lights the code it is about. */
    private read(index: number): void {
      const caption = this.captions[index];
      if (!caption) return;
      this.captions.forEach((other, position) => other.toggleAttribute("data-current", position === index));
      this.dots.forEach((dot, position) => {
        dot.disabled = position >= this.shown;
        if (position === index) dot.setAttribute("aria-current", "step");
        else dot.removeAttribute("aria-current");
      });
      // The lines of earlier steps stay lit, dimmer.
      const [first, last] = (caption.dataset.lines ?? "").split("-").map(Number);
      if (!first) return;
      for (const line of this.lines) {
        if (line.classList.contains("sc-hot")) line.classList.replace("sc-hot", "sc-warm");
      }
      for (let at = first; at <= (last || first); at++) {
        this.lines[at - 1]?.classList.remove("sc-warm");
        this.lines[at - 1]?.classList.add("sc-hot");
      }
      // A long file scrolls inside its pane: bring the lit lines into it.
      const pane = this.root.querySelector<HTMLElement>(".sc-code");
      const line = this.lines[first - 1];
      if (pane && line && pane.scrollHeight > pane.clientHeight) {
        const [box, lit] = [pane.getBoundingClientRect(), line.getBoundingClientRect()];
        if (lit.top < box.top || lit.bottom > box.bottom) pane.scrollBy({ top: lit.top - box.top - box.height / 3, behavior: reduced.matches ? "auto" : "smooth" });
      }
    }
  }

  class Showcase extends HTMLElement {
    private scenes = new Map<string, Scene>();
    private tabs: HTMLElement[] = [];
    private mark: HTMLElement | null = null;
    private current = "";
    private seen = false;

    connectedCallback(): void {
      this.tabs = [...this.querySelectorAll<HTMLElement>("[data-tab]")];
      this.mark = this.querySelector(".sc-mark");
      for (const root of this.querySelectorAll<HTMLElement>("[data-scene]")) {
        const scene = new Scene(root);
        this.scenes.set(root.dataset.scene!, scene);
        scene.rest();
      }
      this.current = this.tabs[0]?.dataset.tab ?? "";
      this.show(this.current, false, false);

      let pointer = 0;
      const rail = this.querySelector<HTMLElement>(".sc-rail")!;
      rail.addEventListener("pointerdown", () => (pointer = performance.now()));
      rail.addEventListener("click", (event) => {
        const tab = (event.target as Element).closest<HTMLElement>("[data-tab]");
        // A marker that slides for a pointer, and jumps for the keyboard.
        if (tab) this.show(tab.dataset.tab!, performance.now() - pointer < 600, true);
      });
      rail.addEventListener("keydown", (event) => {
        const key = (event as KeyboardEvent).key;
        const index = this.tabs.findIndex((tab) => tab.dataset.tab === this.current);
        const moves: Record<string, number> = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: this.tabs.length - 1 };
        if (!(key in moves)) return;
        event.preventDefault();
        const tab = this.tabs[(moves[key]! + this.tabs.length) % this.tabs.length]!;
        this.show(tab.dataset.tab!, false, true);
        tab.focus();
      });
      // Once a scene is over, the next one is a press away.
      this.addEventListener("click", (event) => {
        if (!(event.target as Element).closest("[data-next]")) return;
        const index = this.tabs.findIndex((tab) => tab.dataset.tab === this.current);
        const tab = this.tabs[(index + 1) % this.tabs.length]!;
        this.show(tab.dataset.tab!, true, true);
      });
      // The rail scrolls when it does not fit: its arrows show where there is more.
      const ends = () => {
        const wrap = rail.parentElement!;
        wrap.toggleAttribute("data-earlier", rail.scrollLeft > 4);
        wrap.toggleAttribute("data-later", rail.scrollLeft + rail.clientWidth < rail.scrollWidth - 4);
      };
      rail.addEventListener("scroll", ends, { passive: true });
      addEventListener("resize", ends);
      document.fonts?.ready.then(ends);
      ends();
      rail.parentElement!.addEventListener("click", (event) => {
        const way = (event.target as Element).closest<HTMLElement>("[data-rail]")?.dataset.rail;
        if (way) rail.scrollBy({ left: Number(way) * rail.clientWidth * 0.6, behavior: reduced.matches ? "auto" : "smooth" });
      });
      // The Discord on screen changes language: the same scene, played again.
      this.addEventListener("click", (event) => {
        const language = (event.target as Element).closest<HTMLElement>("[data-client-set]")?.dataset.clientSet;
        if (!language || language === this.dataset.client) return;
        this.dataset.client = language;
        for (const button of this.querySelectorAll<HTMLElement>("[data-client-set]")) {
          button.setAttribute("aria-pressed", String(button.dataset.clientSet === language));
        }
        this.seen = true;
        this.scenes.get(this.current)?.play();
      });
      addEventListener("resize", () => this.place(false));
      document.fonts?.ready.then(() => this.place(false));

      // The first scene plays by itself once, when the showcase comes into view.
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          if (this.seen) return;
          this.seen = true;
          this.scenes.get(this.current)?.play(true);
        },
        { threshold: 0.35 },
      ).observe(this);
    }

    private show(id: string, slide: boolean, play: boolean): void {
      if (play && id === this.current && this.seen) return;
      this.scenes.get(this.current)?.rest();
      this.current = id;
      this.toggleAttribute("data-instant", !slide);
      for (const tab of this.tabs) {
        const selected = tab.dataset.tab === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const [name, scene] of this.scenes) {
        scene.root.toggleAttribute("data-active", name === id);
        scene.root.inert = name !== id;
      }
      this.place(slide);
      if (play) {
        this.seen = true;
        this.scenes.get(id)?.play();
      }
    }

    /** Moves the marker of the rail onto the selected kind. */
    private place(slide: boolean): void {
      const tab = this.tabs.find((candidate) => candidate.dataset.tab === this.current);
      if (!tab || !this.mark) return;
      this.mark.toggleAttribute("data-slide", slide && !reduced.matches);
      this.mark.style.transform = `translateX(${tab.offsetLeft}px) scaleX(${tab.offsetWidth / 100})`;
      // Keep the selected kind in view inside the rail, without moving the page.
      const rail = tab.parentElement!;
      rail.scrollTo({ left: tab.offsetLeft - (rail.clientWidth - tab.offsetWidth) / 2, behavior: slide && !reduced.matches ? "smooth" : "auto" });
    }
  }
  customElements.define("at-showcase", Showcase);
</script>
