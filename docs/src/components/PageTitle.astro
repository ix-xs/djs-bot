---
// The head of a documentation page: which part of the docs this is, the title,
// and the page's description as a lead paragraph.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

/** The labels of the groups that contain the current page, outermost first. */
function trail(entries: Entry[], path: string[] = []): string[] | undefined {
  for (const entry of entries) {
    if (entry.type === "link") {
      if (entry.isCurrent) return path;
    } else {
      const found = trail(entry.entries, [...path, entry.label]);
      if (found) return found;
    }
  }
  return undefined;
}

const { entry, sidebar } = Astro.locals.starlightRoute;
const groups = trail(sidebar) ?? [];
// A page of the API reference sets its own lead, with its code and its links.
const symbolPage = /\/reference\/[^/]+\/$/.test(Astro.url.pathname);
// Every other page opens on its description: one sentence that says what the
// page is for, so the text under it goes straight to the point.
const lead = symbolPage ? undefined : entry.data.description;
const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
/** Backticks become code, everything else is plain text. */
const withCode = (text: string) =>
  text
    .split("`")
    .map((piece, index) => (index % 2 === 1 ? `<code>${escape(piece)}</code>` : escape(piece)))
    .join("");
---

{groups.length > 0 && <p class="at-eyebrow">{groups.join(" / ")}</p>}
<h1 id="_top" class="at-title">{entry.data.title}</h1>
{lead && <p class="at-lead" set:html={withCode(lead)} />}
