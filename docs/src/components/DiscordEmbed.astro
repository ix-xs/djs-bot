---
/** A Discord embed mock: the coloured card produced by `ctx.reply.success()` and friends. */
interface Props {
  color?: string;
  title?: string;
  /** May contain inline HTML. */
  description?: string;
  author?: string;
  footer?: string;
}
const { color = "#5865f2", title, description, author, footer } = Astro.props;
---

<div class="dc-embed" style={`--embed-color:${color}`}>
  {author && <div class="dc-embed-author">{author}</div>}
  {title && <div class="dc-embed-title">{title}</div>}
  {description && <div class="dc-embed-desc" set:html={description} />}
  <slot />
  {footer && <div class="dc-embed-footer">{footer}</div>}
</div>

<style is:global>
  .dc-embed { max-width: 32rem; margin-top: 0.5rem; padding: 0.7rem 0.9rem 0.8rem; border-radius: 4px; border-inline-start: 4px solid var(--embed-color); background: #2b2d31; }
  .dc-embed-author { margin-bottom: 0.25rem; font-size: 0.8rem; font-weight: 600; color: #dbdee1; }
  .dc-embed-title { margin-bottom: 0.3rem; font-weight: 700; color: #f2f3f5; overflow-wrap: anywhere; }
  .dc-embed-desc { font-size: 0.9rem; color: #dbdee1; overflow-wrap: anywhere; }
  .dc-embed-footer { margin-top: 0.6rem; padding-top: 0.45rem; border-top: 1px solid rgb(255 255 255 / 0.08); font-size: 0.72rem; color: #949ba4; }
</style>
