{
  "name": "@ix-xs/djs-bot",
  "version": "1.2.1",
  "description": "Discord bots, fully typed. A TypeScript-first framework on top of discord.js: typed commands, buttons and forms, automatic intents and deferral, i18n, jobs, a store and a CLI.",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "discord-api",
    "bot-framework",
    "framework",
    "slash-commands",
    "interactions",
    "typescript",
    "esm",
    "components-v2",
    "modals",
    "dependency-injection",
    "cli"
  ],
  "author": "ix-xs.dev <contact@ix-xs.dev>",
  "license": "MIT",
  "homepage": "https://ix-xs.github.io/djs-bot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ix-xs/djs-bot.git"
  },
  "bugs": {
    "url": "https://github.com/ix-xs/djs-bot/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "djs-bot": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.mts",
        "default": "./dist/plugins.mjs"
      },
      "require": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ],
      "plugins": [
        "./dist/plugins.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json && tsc -p docs/src/showcase/tsconfig.json",
    "attw": "attw --pack .",
    "check": "npm run typecheck && npm run test:types && npm run build && npm test",
    "bench": "tsx benchmarks/run.ts",
    "docs": "npm --prefix docs install && npm --prefix docs run dev",
    "docs:build": "npm --prefix docs install && npm --prefix docs run build",
    "docs:api": "node docs/scripts/api-index.mjs",
    "lint": "tsc --noEmit",
    "example": "tsx examples/minimal/bot.ts",
    "prepublishOnly": "npm run build",
    "live": "tsx examples/playground/check.ts",
    "playground": "tsx src/cli.ts dev examples/playground/bot.ts",
    "bench:dispatch": "tsx benchmarks/dispatch.ts"
  },
  "dependencies": {
    "@ix-xs/node-comfort": "^2.0.0"
  },
  "peerDependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/node": "^22.10.0",
    "discord.js": "^14.27.0",
    "tinybench": "^6.2.2",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
