{
  "djs-bot: slash command": {
    "scope": "typescript,javascript",
    "prefix": "dcommand",
    "description": "A djs-bot slash command",
    "body": [
      "import { defineCommand, s } from \"@ix-xs/djs-bot\";",
      "",
      "export default defineCommand({",
      "\tname: \"${1:name}\",",
      "\tdescription: \"${2:description}\",",
      "\toptions: {",
      "\t\t${3:text}: s.string({ description: \"${4:text}\", required: true }),",
      "\t},",
      "\trun: async (ctx) => {",
      "\t\tawait ctx.reply.success(\"${5:Done!}\");$0",
      "\t},",
      "});"
    ]
  },
  "djs-bot: command with subcommands": {
    "scope": "typescript,javascript",
    "prefix": "dsub",
    "description": "A djs-bot command with subcommands",
    "body": [
      "import { defineCommand, subcommand, s } from \"@ix-xs/djs-bot\";",
      "",
      "export default defineCommand({",
      "\tname: \"${1:group}\",",
      "\tdescription: \"${2:description}\",",
      "\tsubcommands: {",
      "\t\t${3:view}: subcommand({",
      "\t\t\tdescription: \"${4:View}\",",
      "\t\t\trun: (ctx) => ctx.reply.info(\"${5:...}\"),",
      "\t\t}),",
      "\t},",
      "});$0"
    ]
  },
  "djs-bot: event": {
    "scope": "typescript,javascript",
    "prefix": "devent",
    "description": "A djs-bot gateway event listener",
    "body": [
      "import { defineEvent } from \"@ix-xs/djs-bot\";",
      "",
      "export default defineEvent(\"${1:guildMemberAdd}\", async (${2:member}, ctx) => {",
      "\tctx.logger.info({}, \"${3:event fired}\");$0",
      "});"
    ]
  },
  "djs-bot: button": {
    "scope": "typescript,javascript",
    "prefix": "dbutton",
    "description": "A djs-bot button with typed customId params",
    "body": [
      "import { defineButton, p, ButtonStyle } from \"@ix-xs/djs-bot\";",
      "",
      "export const ${1:MyButton} = defineButton({",
      "\tid: \"${2:feature:action}\",",
      "\tparams: { ${3:id}: p.string },",
      "\tlabel: \"${4:Click}\",",
      "\tstyle: ButtonStyle.Primary,",
      "\trun: async (ctx) => {",
      "\t\tawait ctx.reply.success(`${5:Clicked} ${ctx.params.${3:id}}`);$0",
      "\t},",
      "});"
    ]
  },
  "djs-bot: select menu": {
    "scope": "typescript,javascript",
    "prefix": "dselect",
    "description": "A djs-bot string select menu",
    "body": [
      "import { defineSelectMenu } from \"@ix-xs/djs-bot\";",
      "",
      "export const ${1:MySelect} = defineSelectMenu({",
      "\tid: \"${2:feature:pick}\",",
      "\trun: async (ctx) => {",
      "\t\tawait ctx.reply.success(`Picked: ${ctx.values.join(\", \")}`);$0",
      "\t},",
      "});"
    ]
  },
  "djs-bot: modal": {
    "scope": "typescript,javascript",
    "prefix": "dmodal",
