    ]
  },
  "djs-bot: plugin": {
    "scope": "typescript,javascript",
    "prefix": "dplugin",
    "description": "A djs-bot plugin",
    "body": [
      "import { definePlugin } from \"@ix-xs/djs-bot\";",
