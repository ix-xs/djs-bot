      "\t\t${4:body}: field.paragraph({ label: \"${5:Details}\", required: true }),",
      "\t},",
      "\trun: async (ctx) => {",
      "\t\tawait ctx.reply.success(`Received: ${ctx.fields.${4:body}}`);$0",
      "\t},",
      "});"
    ]
  },
