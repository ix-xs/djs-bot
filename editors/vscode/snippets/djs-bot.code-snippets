  "djs-bot: command with autocomplete": {
    "scope": "typescript,javascript",
    "prefix": "dauto",
    "description": "A djs-bot slash command with an autocomplete option",
    "body": [
      "import { defineCommand, s } from \"@ix-xs/djs-bot\";",
      "",
      "export default defineCommand({",
      "\tname: \"${1:name}\",",
      "\tdescription: \"${2:description}\",",
      "\toptions: {",
      "\t\t${3:query}: s.string({",
      "\t\t\tdescription: \"${4:Search}\",",
      "\t\t\trequired: true,",
      "\t\t\tautocomplete: async (ctx) => {",
      "\t\t\t\t// ctx.value: what was typed. ctx.options: the other options.",
      "\t\t\t\tconst ${5:results} = [${6:\"first\", \"second\"}];",
      "\t\t\t\treturn ${5:results}.filter((name) => name.startsWith(ctx.value));",
      "\t\t\t},",
      "\t\t}),",
      "\t},",
      "\trun: async (ctx) => {",
      "\t\tawait ctx.reply.success(`You picked \\${ctx.options.${3:query}}`);$0",
      "\t},",
      "});"
    ]
  },
