  "djs-bot: form (button that opens a modal)": {
    "scope": "typescript,javascript",
    "prefix": "dform",
    "description": "A button opening a modal with a select and a file upload",
    "body": [
      "import { defineButton, defineModal, field, ButtonStyle } from \"@ix-xs/djs-bot\";",
      "",
      "export const ${1:Report}Form = defineModal({",
      "\tid: \"${2:report}:submit\",",
      "\ttitle: \"${3:Report a problem}\",",
      "\tfields: {",
      "\t\tkind: field.select({",
      "\t\t\tlabel: \"${4:Kind}\",",
      "\t\t\trequired: true,",
      "\t\t\toptions: [",
      "\t\t\t\t{ label: \"${5:Bug}\", value: \"${6:bug}\" },",
      "\t\t\t\t{ label: \"${7:Abuse}\", value: \"${8:abuse}\" },",
      "\t\t\t],",
      "\t\t}),",
      "\t\tdetails: field.paragraph({ label: \"${9:What happened?}\", required: true }),",
      "\t\tproof: field.files({ label: \"${10:Screenshots}\", maxValues: 3, fileTypes: [\"image\"] }),",
      "\t},",
      "\trun: async (ctx) => {",
      "\t\tawait ctx.reply.success(`\\${ctx.fields.kind[0]}: \\${ctx.fields.proof.size} file(s)`, { ephemeral: true });$0",
      "\t},",
      "});",
      "",
      "export const Open${1:Report} = defineButton({",
      "\tid: \"${2:report}:open\",",
      "\tlabel: \"${3:Report a problem}\",",
      "\tstyle: ButtonStyle.Secondary,",
      "\trun: (ctx) => ctx.showModal(${1:Report}Form),",
      "});"
    ]
  },
