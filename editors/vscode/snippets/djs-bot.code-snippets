  },
  "djs-bot: feature": {
    "scope": "typescript,javascript",
    "prefix": "dfeature",
    "description": "A djs-bot feature pack",
    "body": [
      "import { defineFeature } from \"@ix-xs/djs-bot\";",
      "",
      "export default defineFeature({",
      "\tname: \"${1:name}\",",
      "\trequires: [${2}],",
      "\tcommands: [${3}],$0",
      "});"
    ]
  },
  "djs-bot: bot entry": {
    "scope": "typescript,javascript",
    "prefix": "dbot",
    "description": "A djs-bot entry file",
    "body": [
      "import { defineBot, env } from \"@ix-xs/djs-bot\";",
      "",
      "const bot = defineBot({",
      "\ttoken: env(\"DISCORD_TOKEN\"),",
      "\tfeatures: \"${1:./src/features}\",",
      "\tintents: \"auto\",",
      "});",
      "",
      "export default bot;",
      "",
      "if (!process.env.DJSBOT_CLI) void bot.start();$0"
    ]
  }
}
