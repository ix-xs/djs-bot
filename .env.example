# Copy to `.env` and fill in. Loaded automatically by the djs-bot CLI.
# NEVER put a real token in this template file — put it in .env (gitignored).
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id
# Optional: a guild to deploy commands to instantly during development.
DISCORD_DEV_GUILD=your-dev-guild-id
NODE_ENV=development
